{
  "name": "prism-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "node scripts/storybook.mjs dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "node scripts/storybook.mjs build --disable-telemetry",
    "test:desktop": "playwright test",
    "test:visual": "playwright test --config playwright.fernly.config.ts",
    "test:visual:storybook": "playwright test --config playwright.fernly.storybook.config.ts",
    "test:responsive": "playwright test --config playwright.responsive.config.ts",
    "test:motion": "playwright test --config playwright.motion.config.ts",
    "test:desktop:update": "playwright test --update-snapshots",
    "test:storybook:browser": "playwright test --config playwright.storybook.config.ts",
    "fixtures:prepare": "node scripts/prepare-fixtures.mjs",
    "test:local-regression": "playwright test --config playwright.local.config.ts",
    "test:procurement": "playwright test --config playwright.procurement.config.ts",
    "test:review": "playwright test --config playwright.review.config.ts",
    "test:spreadsheets": "playwright test --config playwright.spreadsheet.config.ts",
    "test:oe": "playwright test --config playwright.oe.config.ts",
    "test:intake": "playwright test --config playwright.intake.config.ts",
    "test:evaluation": "playwright test --config playwright.evaluation.config.ts",
    "demo:pertamina": "node scripts/pertamina-demo.mjs",
    "dev:standard": "vite --host 127.0.0.1",
    "package:pertamina": "node scripts/pertamina-export.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.3",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
